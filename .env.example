# TempChat Environment Variables
# Provide your Supabase project credentials for cloud database and real-time synchronization.
# If not provided, TempChat automatically operates in Local Multi-Tab Realtime mode.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
